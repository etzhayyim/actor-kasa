{:paths ["src" "test"]
 :deps {
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "98045c7ad26c71c3505cb8fefdcbe0dcdf98f925"}}
 :tasks {test {:requires ([clojure.test] [kasa.methods.test-doubling]
                          [kasa.methods.test-ingest] [kasa.murakumo-test]
                          [kasa.tests.test-invariants] [kasa.tests.test-kasa])
               :task (let [r (clojure.test/run-tests 'kasa.methods.test-doubling
                              'kasa.methods.test-ingest 'kasa.murakumo-test
                              'kasa.tests.test-invariants 'kasa.tests.test-kasa)]
                       (when (pos? (+ (:fail r) (:error r))) (throw (ex-info "kasa tests failed" r))) r)}}}
